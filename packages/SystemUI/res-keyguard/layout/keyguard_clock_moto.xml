<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/clock_main_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:gravity="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">

        <!-- Time (Hour + Minute, stacked tightly) -->
        <TextClock
            android:id="@+id/clock_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="HHmm"
            android:format24Hour="HHmm"
            android:textColor="@android:color/white"
            android:textSize="120sp"
            android:fontFamily="@font/oppodigit08"
            android:includeFontPadding="false"
            android:letterSpacing="0.05"
            android:gravity="center"
            android:alpha="0.95" />

        <!-- Day (TUESDAY) -->
        <TextClock
            android:id="@+id/clock_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE"
            android:format24Hour="EEEE"
            android:textColor="@android:color/white"
            android:textSize="85sp"
            android:fontFamily="@font/oppodigit08"
            android:includeFontPadding="false"
            android:gravity="center"
            android:alpha="0.95"
            android:textAllCaps="true"
            android:layout_marginTop="-20dp" />

        <!-- Date (8/5 style) -->
        <TextClock
            android:id="@+id/clock_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="M/d"
            android:format24Hour="M/d"
            android:textColor="@android:color/white"
            android:textSize="90sp"
            android:fontFamily="@font/oppodigit08"
            android:includeFontPadding="false"
            android:gravity="center"
            android:alpha="0.95"
            android:layout_marginTop="-15dp" />

    </LinearLayout>

</FrameLayout>
