<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/date_day_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="30dp"
        android:orientation="horizontal"
        android:gravity="top">

        <TextClock
            android:id="@+id/date_top_left"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:format12Hour="MMM d"
            android:format24Hour="MMM d"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:fontFamily="@font/oppodigit08"
            android:singleLine="true" />

        <TextClock
            android:id="@+id/day_top_right"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:format12Hour="EEE"
            android:format24Hour="EEE"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:fontFamily="@font/oppodigit08"
            android:singleLine="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/clock_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" 
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="68dp"> 
        <TextClock
            android:id="@+id/clock_hours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="HH"
            android:format24Hour="HH"
            android:textColor="@android:color/white"
            android:textSize="180sp"
            android:fontFamily="@font/oppomodakheavyexport"
            android:includeFontPadding="false"
            android:alpha="0.5"
            android:layout_marginEnd="0dp" />

        <TextClock
            android:id="@+id/clock_minutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="mm"
            android:format24Hour="mm"
            android:textColor="@android:color/white"
            android:textSize="180sp"
            android:fontFamily="@font/oppomodakheavyexport"
            android:includeFontPadding="false"
            android:alpha="0.5" />
    </LinearLayout>

</FrameLayout>
